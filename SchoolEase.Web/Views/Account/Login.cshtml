@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
}

<div class="se-auth__card">
    <div class="text-center mb-4">
        <div class="se-auth__logo-large">
            @await Html.PartialAsync("_Logo")
        </div>
        <h1 class="h3 mb-1 fw-bold">Welcome back</h1>
        <p class="se-muted se-small mb-0">Sign in to your SchoolEase account.</p>
    </div>

    <form asp-action="Login" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 se-small @(ViewData.ModelState.ErrorCount > 0 ? "" : "d-none")"></div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-envelope se-muted"></i></span>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@schoolease.ph" autofocus />
            </div>
            <span asp-validation-for="Email" class="text-danger se-small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-lock se-muted"></i></span>
                <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Enter your password" id="sePassword" />
                <button type="button" class="btn btn-light" id="seTogglePassword" aria-label="Show password">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger se-small"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label se-small"></label>
            </div>
            <span class="se-small se-muted">Protected by lockout policy</span>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 mb-3">
            <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
        </button>

        <div class="text-center se-small">
            <span class="se-muted">Don't have an account?</span>
            <a asp-action="Register" class="fw-bold">Create one now</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var password = document.getElementById("sePassword");

            document.getElementById("seTogglePassword").addEventListener("click", function () {
                var isText = password.type === "text";
                password.type = isText ? "password" : "text";
                this.querySelector("i").className = isText ? "bi bi-eye" : "bi bi-eye-slash";
            });
        })();
    </script>
}
