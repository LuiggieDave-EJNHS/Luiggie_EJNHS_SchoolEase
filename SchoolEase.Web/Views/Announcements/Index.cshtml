@model AnnouncementListViewModel
@{
    ViewData["Title"] = "Announcements";
    var actions = new List<PageAction>();
    if (Model.CanManage)
    {
        actions.Add(new PageAction { Text = "New Announcement", Url = Url.Action("Create"), Icon = "bi-plus-lg" });
    }
}

<partial name="_PageHeader" model="@(new PageHeader
{
    Title = "Announcements",
    Subtitle = "School bulletins, advisories and reminders.",
    Icon = "bi-megaphone",
    Actions = actions
})" />

<div class="se-card mb-3">
    <form method="get" asp-action="Index" class="se-filters">
        <select name="priority" class="form-select" data-se-autosubmit aria-label="Filter by priority">
            <option value="">All priorities</option>
            @foreach (var opt in SelectLists.EnumOptions<AnnouncementPriority>(Model.Priority))
            {
                <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
            }
        </select>
        <select name="audience" class="form-select" data-se-autosubmit aria-label="Filter by audience">
            <option value="">All audiences</option>
            @foreach (var opt in SelectLists.EnumOptions<Audience>(Model.Audience))
            {
                <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
            }
        </select>
        <input name="keyword" value="@Model.Keyword" class="form-control se-filters__grow"
               placeholder="Search title, content or author…" />
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
        <button type="button" class="btn btn-light" data-se-reset="@Url.Action("Index")">Reset</button>
    </form>

    <div class="se-card__body">
        @if (Model.Announcements.Count == 0)
        {
            <partial name="_EmptyState" model="@(new EmptyState
            {
                Icon = "bi-megaphone",
                Title = "No announcements",
                Message = "There are no bulletins to show right now.",
                ActionText = Model.CanManage ? "Post announcement" : null,
                ActionUrl = Model.CanManage ? Url.Action("Create") : null
            })" />
        }
        else
        {
            foreach (var item in Model.Announcements)
            {
                <div class="se-announce se-announce--@item.PriorityCss">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h4>
                            <a class="text-decoration-none text-reset" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                        </h4>
                        @if (Model.CanManage)
                        {
                            <div class="d-flex gap-1">
                                <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                      data-se-confirm="Delete this announcement?">
                                    <button type="submit" class="btn btn-sm btn-light text-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                    <p>@(item.Content.Length > 220 ? item.Content[..220] + "…" : item.Content)</p>
                    <div class="se-announce__meta">
                        <span><i class="bi bi-person me-1"></i>@item.AuthorName</span>
                        <span><i class="bi bi-clock me-1"></i>@item.PublishDate.ToRelativeTime()</span>
                        <span class="se-badge text-bg-@item.PriorityCss">@item.Priority.DisplayName()</span>
                        <span class="se-badge text-bg-secondary"><i class="bi bi-people"></i>@item.Audience.DisplayName()</span>
                        @if (!item.IsPublished)
                        {
                            <span class="se-badge text-bg-dark"><i class="bi bi-eye-slash"></i>Draft</span>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <partial name="_Pagination" model="@(ViewData["Pagination"] as PaginationInfo ?? new PaginationInfo())" />
</div>
