@model SubjectFormViewModel
@{
    ViewData["Title"] = "New Subject";
}

<partial name="_PageHeader" model="@(new PageHeader
{
    Title = "New Subject",
    Subtitle = "Add a learning area to the subject catalogue.",
    Icon = "bi-journal-bookmark",
    Actions = new List<PageAction>
    {
        new() { Text = "Back to list", Url = Url.Action("Index"), Icon = "bi-arrow-left", Css = "btn btn-light" }
    }
})" />

<div class="se-card">
    <form asp-action="Create" method="post">
        <div class="se-card__body">
            <partial name="_Form" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save subject</button>
                <a class="btn btn-light" asp-action="Index">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
