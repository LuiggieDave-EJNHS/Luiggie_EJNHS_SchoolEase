@model SubjectFormViewModel
@{
    ViewData["Title"] = "Edit Subject";
}

<partial name="_PageHeader" model="@(new PageHeader
{
    Title = "Edit Subject",
    Subtitle = Model.Title,
    Icon = "bi-journal-bookmark",
    Actions = new List<PageAction>
    {
        new() { Text = "View subject", Url = Url.Action("Details", new { id = Model.Id }), Icon = "bi-eye", Css = "btn btn-light" }
    }
})" />

<div class="se-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="se-card__body">
            <partial name="_Form" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save changes</button>
                <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
