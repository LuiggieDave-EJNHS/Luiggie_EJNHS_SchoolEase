@model ActivitySheetFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.Title}";
}

<partial name="_PageHeader" model="@(new PageHeader
{
    Title = "Edit Activity Sheet",
    Subtitle = "Update the details or replace the uploaded file.",
    Icon = "bi-journal-text",
    Actions = new List<PageAction>
    {
        new() { Text = "Back to sheet", Url = Url.Action("Details", new { id = Model.Id }), Icon = "bi-arrow-left", Css = "btn btn-light" }
    }
})" />

<div class="se-card">
    <div class="se-card__body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 se-small"></div>
            <input type="hidden" asp-for="Id" />

            <partial name="_Form" model="Model" />

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save changes</button>
                <a class="btn btn-light" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>
