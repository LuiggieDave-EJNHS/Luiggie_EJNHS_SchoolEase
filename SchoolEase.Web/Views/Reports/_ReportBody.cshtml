@model ReportResult
@{
    string AlignCss(string align) => align == "center" ? "center" : align == "right" ? "num" : string.Empty;
}

<div class="se-report">
    <div class="se-report__head">
        <div class="se-report__school">@SchoolInfo.SchoolName</div>
        <div class="se-report__addr">@SchoolInfo.SchoolAddress &bull; @SchoolInfo.Division</div>
        <h2>@Model.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
        {
            <div class="se-report__addr">@Model.Subtitle</div>
        }
    </div>

    <div class="se-report__meta">
        <span><i class="bi bi-person me-1"></i>Generated by: @Model.GeneratedBy</span>
        <span><i class="bi bi-clock me-1"></i>@Model.GeneratedAt.ToString("MMM d, yyyy h:mm tt")</span>
        @if (!string.IsNullOrWhiteSpace(Model.FilterSummary))
        {
            <span><i class="bi bi-funnel me-1"></i>@Model.FilterSummary</span>
        }
    </div>

    @if (Model.IsEmpty)
    {
        <p class="se-muted se-small mb-0">No records matched the selected filters.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    @foreach (var column in Model.Columns)
                    {
                        <th class="@AlignCss(column.Align)">@column.Header</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        @for (var i = 0; i < Model.Columns.Count; i++)
                        {
                            var align = i < row.Cells.Count ? Model.Columns[i].Align : "left";
                            var cell = i < row.Cells.Count ? row.Cells[i] : string.Empty;
                            <td class="@AlignCss(align)">@cell</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.Summary.Count > 0)
    {
        <dl class="se-report__summary">
            @foreach (var entry in Model.Summary)
            {
                <div>
                    <dt>@entry.Key</dt>
                    <dd>@entry.Value</dd>
                </div>
            }
        </dl>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Note))
    {
        <p class="se-report__note"><i class="bi bi-info-circle me-1"></i>@Model.Note</p>
    }

    <div class="se-report__sign">
        <div>
            <span>Prepared by: @Model.GeneratedBy</span>
        </div>
        <div>
            <span>Approved by: School Principal</span>
        </div>
    </div>
</div>
