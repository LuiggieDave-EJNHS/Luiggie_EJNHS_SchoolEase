@model ReportPageViewModel
@{
    ViewData["Title"] = Model.Report?.Title ?? "Print report";
}

<div class="d-print-none mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h1 class="h5 mb-1">@Model.Report?.Title</h1>
        <p class="se-small se-muted mb-0">Use the buttons below to print or return to the reports page.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button>
        <a class="btn btn-light" asp-action="ExportCsv" asp-all-route-data="@Model.RouteValues()"><i class="bi bi-filetype-csv me-1"></i>Export CSV</a>
        <a class="btn btn-light" asp-action="Index" asp-all-route-data="@Model.RouteValues()"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

@if (Model.Report is null)
{
    <div class="se-card">
        <partial name="_EmptyState" model="@(new EmptyState
        {
            Icon = "bi-file-earmark-bar-graph",
            Title = "Nothing to print",
            Message = "Choose a report type and filters to generate a report."
        })" />
    </div>
}
else
{
    <partial name="_ReportBody" model="Model.Report" />
}

@section Scripts {
    <script>
        window.addEventListener("DOMContentLoaded", function () {
            window.print();
        });
    </script>
}
