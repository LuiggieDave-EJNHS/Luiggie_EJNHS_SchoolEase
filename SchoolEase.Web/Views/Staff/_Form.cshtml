@model Staff

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 se-small"></div>
<input type="hidden" asp-for="Id" />

<div class="se-form-grid se-form-grid--3">
    <div class="se-form-section"><h3>Identity</h3></div>

    <div>
        <label class="form-label" asp-for="StaffNumber"></label>
        <input asp-for="StaffNumber" class="form-control" placeholder="Auto-generated when blank" />
        <span asp-validation-for="StaffNumber" class="text-danger se-small"></span>
    </div>
    <div>
        <label class="form-label" asp-for="Gender"></label>
        <select asp-for="Gender" asp-items="SelectLists.EnumOptions<Gender>(Model.Gender)" class="form-select"></select>
        <span asp-validation-for="Gender" class="text-danger se-small"></span>
    </div>
    <div>
        <label class="form-label" asp-for="BirthDate"></label>
        <input asp-for="BirthDate" type="date" class="form-control" />
        <span asp-validation-for="BirthDate" class="text-danger se-small"></span>
    </div>

    <div>
        <label class="form-label" asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger se-small"></span>
    </div>
    <div>
        <label class="form-label" asp-for="MiddleName"></label>
        <input asp-for="MiddleName" class="form-control" />
        <span asp-validation-for="MiddleName" class="text-danger se-small"></span>
    </div>
    <div>
        <label class="form-label" asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger se-small"></span>
    </div>

    <div class="se-span-3">
        <label class="form-label" asp-for="Address"></label>
        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Address" class="text-danger se-small"></span>
    </div>

    <div class="se-form-section"><h3>Contact</h3></div>

    <div>
        <label class="form-label" asp-for="ContactNumber"></label>
        <input asp-for="ContactNumber" class="form-control" />
        <span asp-validation-for="ContactNumber" class="text-danger se-small"></span>
    </div>
    <div>
        <label class="form-label" asp-for="Email"></label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger se-small"></span>
    </div>
    <div></div>

    <div class="se-form-section"><h3>Employment</h3></div>

    <div>
        <label class="form-label" asp-for="Position"></label>
        <input asp-for="Position" class="form-control" placeholder="e.g. School Registrar" />
        <span asp-validation-for="Position" class="text-danger se-small"></span>
    </div>
    <div>
        <label class="form-label" asp-for="Department"></label>
        <input asp-for="Department" class="form-control" placeholder="e.g. Office of the Registrar" />
        <span asp-validation-for="Department" class="text-danger se-small"></span>
    </div>
    <div>
        <label class="form-label" asp-for="EmploymentStatus"></label>
        <select asp-for="EmploymentStatus" asp-items="SelectLists.EnumOptions<EmploymentStatus>(Model.EmploymentStatus)" class="form-select"></select>
        <span asp-validation-for="EmploymentStatus" class="text-danger se-small"></span>
    </div>

    <div>
        <label class="form-label" asp-for="DateHired"></label>
        <input asp-for="DateHired" type="date" class="form-control" />
        <span asp-validation-for="DateHired" class="text-danger se-small"></span>
    </div>
    <div>
        <label class="form-label" asp-for="IsActive"></label>
        <div class="form-check mt-1">
            <input asp-for="IsActive" class="form-check-input" />
            <label class="form-check-label se-small" asp-for="IsActive">Active staff member</label>
        </div>
    </div>
</div>

<div class="form-actions">
    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save</button>
    <a class="btn btn-light" asp-action="Index">Cancel</a>
</div>
