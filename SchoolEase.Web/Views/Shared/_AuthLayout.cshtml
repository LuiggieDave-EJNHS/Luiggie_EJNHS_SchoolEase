@{
    var pageTitle = ViewData["Title"] as string ?? "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle &bull; @SchoolInfo.Name</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/schoolease.css" asp-append-version="true" />
</head>
<body>
    <div class="se-auth">
        <aside class="se-auth__aside">
            <a class="se-auth__brand text-white text-decoration-none" asp-controller="Home" asp-action="Index">
                <span class="se-sidebar__logo">@await Html.PartialAsync("_Logo")</span>
                <span>
                    <strong class="d-block fs-5" style="letter-spacing:-0.01em;">@SchoolInfo.SchoolName</strong>
                    <span class="se-tiny" style="color:#9db8e0; font-weight: 600; text-transform: uppercase;">SchoolEase &bull; @SchoolInfo.Tagline</span>
                </span>
            </a>

            <div>
                <span class="se-badge bg-soft-primary mb-3 text-white border-0" style="background:rgba(255,255,255,0.15)">
                    <i class="bi bi-quote me-1"></i> Ang Aral ng Katipunan
                </span>
                <h2 class="se-auth__headline">"Ang Aral ng Katipunan ng mga Anak ng Bayan ni Emilio D. Jacinto"</h2>
                <p class="se-auth__sub">
                    Building a future-ready academic community through efficient school management and 
                    the enduring values of our national heroes.
                </p>
                <ul class="se-auth__features">
                    <li><i class="bi bi-check-circle-fill"></i> Centralized Student & Faculty Information</li>
                    <li><i class="bi bi-check-circle-fill"></i> Automated Grading & Attendance Tracking</li>
                    <li><i class="bi bi-check-circle-fill"></i> Streamlined Document Requests & Records</li>
                </ul>
            </div>

            <p class="se-tiny mb-0" style="color:#9db8e0;">
                @SchoolInfo.SchoolName &bull; @SchoolInfo.Division<br />
                @SchoolInfo.SchoolAddress
            </p>
        </aside>

        <main class="se-auth__main">
            @RenderBody()
        </main>
    </div>

    <div class="se-toasts" id="seToasts"></div>
    <partial name="_Flash" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/schoolease.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
