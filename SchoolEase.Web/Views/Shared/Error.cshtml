@model ErrorViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Error";
}
<div class="se-auth__card text-center">
    <div class="se-empty__icon mx-auto" style="background:#fdeaec;color:#a52230;">
        <i class="bi bi-exclamation-octagon"></i>
    </div>
    <h1 class="h4 mb-2">An error occurred</h1>
    <p class="se-muted se-small mb-4">
        Sorry, something went wrong while processing your request. Please try again,
        and if the problem continues, contact the school ICT office.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="se-tiny se-muted">Reference ID: <code>@Model.RequestId</code></p>
    }

    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-primary" href="@(CurrentUser.IsAuthenticated ? CurrentUser.HomeAction : "/")">
            <i class="bi bi-house me-1"></i>@(CurrentUser.IsAuthenticated ? "Back to dashboard" : "Back to home")
        </a>
        <a class="btn btn-light" href="javascript:history.back()"><i class="bi bi-arrow-left me-1"></i>Go back</a>
    </div>
</div>
