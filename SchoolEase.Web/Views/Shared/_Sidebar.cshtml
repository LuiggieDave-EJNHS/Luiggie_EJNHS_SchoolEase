@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string Active(string c, params string[] actions)
    {
        if (!string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)) return string.Empty;
        if (actions.Length == 0) return "active";
        return actions.Any(a => string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
    }

    var isAdmin = CurrentUser.IsAdministrator;
    var isTeacher = CurrentUser.IsTeacher;
    var isStudent = CurrentUser.IsStudent;
    var isFormerStudent = CurrentUser.IsFormerStudent;
    var isRegistrar = CurrentUser.IsRegistrar;
    var isCoordinator = CurrentUser.IsIctHeadCoordinator;
}

<aside class="se-sidebar" id="seSidebar">
    <div class="se-sidebar__brand">
        <span class="se-sidebar__logo">@await Html.PartialAsync("_Logo")</span>
        <span class="se-sidebar__title">
            <strong>SchoolEase</strong>
            <span>EJNHS Management</span>
        </span>
    </div>

