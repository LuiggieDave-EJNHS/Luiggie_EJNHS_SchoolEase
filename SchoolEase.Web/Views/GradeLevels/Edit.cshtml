@model GradeLevelFormViewModel
@{
    ViewData["Title"] = "Edit Grade Level";
}

<partial name="_PageHeader" model="@(new PageHeader
{
    Title = "Edit Grade Level",
    Subtitle = Model.Name,
    Icon = "bi-layers",
    Actions = new List<PageAction>
    {
        new() { Text = "Back to list", Url = Url.Action("Index"), Icon = "bi-arrow-left", Css = "btn btn-light" }
    }
})" />

<div class="se-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="se-card__body">
            <partial name="_Form" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save changes</button>
                <a class="btn btn-light" asp-action="Index">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
