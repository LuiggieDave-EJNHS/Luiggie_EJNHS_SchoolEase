@model TeacherIndexViewModel
@{
    ViewData["Title"] = "Teachers";
    var isFiltered = !string.IsNullOrWhiteSpace(Model.Keyword)
        || !string.IsNullOrWhiteSpace(Model.Department)
        || Model.Status is not null;
}

@functions {
    string SortIcon(string field) => Model.Sort == field ? "bi-sort-down"
        : Model.Sort == "-" + field ? "bi-sort-up"
        : "bi-arrow-down-up";

    string NextSort(string field) => Model.Sort == field ? "-" + field : field;
}

<partial name="_PageHeader" model="@(new PageHeader
{
    Title = "Teachers",
    Subtitle = $"Teaching personnel for S.Y. {SchoolInfo.SchoolYear}",
    Icon = "bi-person-video3",
    Actions = new List<PageAction>
    {
        new() { Text = "Add Teacher", Url = Url.Action("Create"), Icon = "bi-person-plus" }
    }
})" />

<div class="row g-3 mb-3">
    @foreach (var card in Model.Stats)
    {
        <div class="col-6 col-xl-3">
            <partial name="_StatCard" model="card" />
        </div>
    }
</div>

<div class="se-card">
    <form method="get" class="se-filters">
        <div class="se-filters__grow">
            <label class="form-label se-small">Search</label>
            <input type="search" name="keyword" value="@Model.Keyword" class="form-control"
                   placeholder="Name, employee number or email" />
        </div>
        <div>
            <label class="form-label se-small">Department</label>
            <select name="department" asp-items="Model.Departments" class="form-select" data-se-autosubmit>
                <option value="">All departments</option>
            </select>
        </div>
        <div>
            <label class="form-label se-small">Employment Status</label>
            <select name="status" asp-items="Model.Statuses" class="form-select" data-se-autosubmit>
                <option value="">All statuses</option>
            </select>
        </div>
        <div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Apply</button>
        </div>
        <div>
            <button type="button" class="btn btn-light" data-se-reset="@Url.Action("Index")">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
            </button>
        </div>
    </form>

    @if (Model.Teachers.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyState
        {
            Icon = "bi-person-video3",
            Title = isFiltered ? "No matching teachers" : "No teachers yet",
            Message = isFiltered
                ? "Try adjusting or clearing the filters to see more personnel."
                : "Add your first teaching personnel to build the faculty roster.",
            ActionText = "Add teacher",
            ActionUrl = Url.Action("Create")
        })" />
    }
    else
    {
        <div class="se-table-wrap">
            <table class="se-table">
                <thead>
                    <tr>
                        <th>
                            <a asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-department="@Model.Department"
                               asp-route-status="@Model.Status" asp-route-sort="@NextSort("number")">
                                Employee No. <i class="bi @SortIcon("number")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-keyword="@Model.Keyword" asp-route-department="@Model.Department"
                               asp-route-status="@Model.Status" asp-route-sort="@NextSort("name")">
                                Name <i class="bi @SortIcon("name")"></i>
                            </a>
                        </th>
                        <th>Department</th>
                        <th>Specialization</th>
                        <th>Employment Status</th>
                        <th>Contact</th>
                        <th>Advisory</th>
                        <th class="se-col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Teachers)
                    {
                        <tr>
                            <td><span class="se-id-chip">@t.EmployeeNumber</span></td>
                            <td>
                                <span class="d-flex align-items-center gap-2">
                                    <span class="se-avatar se-avatar--@t.FullName.AvatarTone()">@t.FullName.Initials()</span>
                                    <span>
                                        <span class="se-strong d-block">@t.FullName</span>
                                        <span class="se-tiny se-muted">@(string.IsNullOrWhiteSpace(t.Email) ? "No email" : t.Email)</span>
                                    </span>
                                </span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(t.Department) ? "—" : t.Department)</td>
                            <td>@(string.IsNullOrWhiteSpace(t.Specialization) ? "—" : t.Specialization)</td>
                            <td><span class="se-badge text-bg-@t.EmploymentStatus.BootstrapTone()">@t.EmploymentStatus.DisplayName()</span></td>
                            <td>@(string.IsNullOrWhiteSpace(t.ContactNumber) ? "—" : t.ContactNumber)</td>
                            <td><span class="se-pill"><i class="bi bi-diagram-3"></i>@t.AdvisorySections.Count</span></td>
                            <td class="se-col-actions">
                                <div class="se-row-actions">
                                    <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@t.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@t.Id" title="Details"><i class="bi bi-eye"></i></a>
                                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline"
                                          data-se-confirm="Delete this teacher? This cannot be undone.">
                                        <button type="submit" class="btn btn-sm btn-light text-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<partial name="_Pagination" model="@(ViewData["Pagination"] as PaginationInfo ?? new PaginationInfo())" />
