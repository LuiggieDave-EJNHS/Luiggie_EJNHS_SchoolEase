@model SettingsIndexViewModel
@{
    ViewData["Title"] = "System Settings";
    var summary = Model.Summary;
}

<partial name="_PageHeader" model="@(new PageHeader
{
    Title = "System Settings",
    Subtitle = "Manage school-wide configuration and review system information.",
    Icon = "bi-sliders",
    Actions = new List<PageAction>
    {
        new() { Text = "Audit Logs", Url = Url.Action("Index", "AuditLogs"), Icon = "bi-shield-check", Css = "btn btn-light" }
    }
})" />

<form asp-action="Save" method="post">
    <div class="row g-3">
        <div class="col-lg-8">
            @if (Model.Settings.Count == 0)
            {
                <div class="se-card">
                    <partial name="_EmptyState" model="@(new EmptyState
                    {
                        Icon = "bi-sliders",
                        Title = "No settings found",
                        Message = "System settings will appear here once they are seeded."
                    })" />
                </div>
            }
            else
            {
                foreach (var group in Model.Groups)
                {
                    <div class="se-card mb-3">
                        <div class="se-card__head">
                            <h3><i class="bi bi-gear me-1"></i>@group.Key</h3>
                            <span class="se-pill"><i class="bi bi-list"></i>@group.Count()</span>
                        </div>
                        <div class="se-card__body">
                            @foreach (var setting in group)
                            {
                                <div class="mb-3">
                                    <label class="se-form-label" for="setting_@setting.Id">@setting.Key</label>
                                    <input id="setting_@setting.Id" name="values[@setting.Key]" value="@setting.Value" class="form-control" />
                                    @if (!string.IsNullOrWhiteSpace(setting.Description))
                                    {
                                        <span class="se-tiny se-muted d-block mt-1">@setting.Description</span>
                                    }
                                    <span class="se-tiny se-muted d-block">
                                        Last updated @setting.UpdatedAt.ToRelativeTime()@(string.IsNullOrWhiteSpace(setting.UpdatedByName) ? "" : $" by {setting.UpdatedByName}")
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Save settings</button>
                    <a class="btn btn-light" asp-action="Index">Reset</a>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="se-card mb-3">
                <div class="se-card__head"><h3><i class="bi bi-cpu me-1"></i>System information</h3></div>
                <div class="se-card__body">
                    <dl class="row se-small mb-0">
                        <dt class="col-6 se-muted">Database provider</dt>
                        <dd class="col-6">@summary.ProviderDisplayName</dd>
                        <dt class="col-6 se-muted">Framework</dt>
                        <dd class="col-6">@summary.AspNetCoreVersion</dd>
                        <dt class="col-6 se-muted">Server time</dt>
                        <dd class="col-6">@summary.ServerTime.ToString("MMM d, yyyy h:mm tt")</dd>
                        <dt class="col-6 se-muted">School year</dt>
                        <dd class="col-6">S.Y. @SchoolInfo.SchoolYear</dd>
                    </dl>
                    <hr />
                    <div class="row g-2 text-center">
                        <div class="col-4"><span class="se-strong d-block">@summary.Students</span><span class="se-tiny se-muted">Students</span></div>
                        <div class="col-4"><span class="se-strong d-block">@summary.Teachers</span><span class="se-tiny se-muted">Teachers</span></div>
                        <div class="col-4"><span class="se-strong d-block">@summary.Staff</span><span class="se-tiny se-muted">Staff</span></div>
                        <div class="col-4"><span class="se-strong d-block">@summary.Sections</span><span class="se-tiny se-muted">Sections</span></div>
                        <div class="col-4"><span class="se-strong d-block">@summary.Subjects</span><span class="se-tiny se-muted">Subjects</span></div>
                        <div class="col-4"><span class="se-strong d-block">@summary.Users</span><span class="se-tiny se-muted">Users</span></div>
                    </div>
                </div>
            </div>

            <div class="se-card">
                <div class="se-card__head"><h3><i class="bi bi-database me-1"></i>Database &amp; provider</h3></div>
                <div class="se-card__body">
                    <p class="se-small mb-2">
                        SchoolEase ships with <strong>SQLite</strong> so it runs with zero setup. You can switch engines
                        at any time without changing any code.
                    </p>
                    <ol class="se-small se-muted ps-3 mb-2">
                        <li>Open <code>appsettings.json</code>.</li>
                        <li>Set <code>Database:Provider</code> to <code>Sqlite</code>, <code>MySql</code> or <code>SqlServer</code>.</li>
                        <li>Point <code>ConnectionStrings:DefaultConnection</code> at the target server.</li>
                        <li>Restart the application.</li>
                    </ol>
                    <p class="se-small se-muted mb-0">
                        Active provider: <strong>@summary.ProviderDisplayName</strong>
                    </p>
                </div>
            </div>

            @if (User.IsInRole(Roles.SuperAdministrator))
            {
                <div class="se-card mt-3">
                    <div class="se-card__head">
                        <h3><i class="bi bi-shield-lock me-1"></i>Account recovery code</h3>
                        @if (Model.HasRecoveryCode)
                        {
                            <span class="se-pill"><i class="bi bi-check2-circle"></i>Active</span>
                        }
                        else
                        {
                            <span class="se-pill"><i class="bi bi-dash-circle"></i>Not set</span>
                        }
                    </div>
                    <div class="se-card__body">
                        @if (TempData["NewRecoveryCode"] is string newCode)
                        {
                            <div class="alert alert-warning py-2 se-small">
                                <strong><i class="bi bi-exclamation-triangle me-1"></i>Save this code now — it will never be shown again.</strong>
                                <div class="se-mono fw-bold text-center my-2 py-2"
                                     style="background:#fff;border:1px dashed #c9a227;border-radius:8px;letter-spacing:2px;">
                                    @newCode
                                </div>
                                <span class="se-tiny">Keep it private. Anyone with this code can unlock your administrator account.</span>
                            </div>
                        }

                        <p class="se-small mb-2">
                            A private, single-use backup for unlocking your own account after
                            <strong>too many failed sign-in attempts</strong>. Only a Super Administrator sees this.
                        </p>

                        @if (Model.HasRecoveryCode)
                        {
                            <p class="se-tiny se-muted">Last generated @Model.RecoveryCodeCreatedAt.</p>
                        }

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" form="recoveryForm" formaction="@Url.Action("GenerateRecoveryCode")"
                                    class="btn btn-primary">
                                <i class="bi bi-arrow-repeat me-1"></i>@(Model.HasRecoveryCode ? "Regenerate code" : "Generate code")
                            </button>
                            @if (Model.HasRecoveryCode)
                            {
                                <button type="submit" form="recoveryForm" formaction="@Url.Action("ClearRecoveryCode")"
                                        class="btn btn-light">
                                    <i class="bi bi-x-circle me-1"></i>Revoke
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (User.IsInRole(Roles.SuperAdministrator))
        {
            var demo = Model.DemoData;
            var clean = demo is null || demo.IsEmpty;
            <div class="se-card mt-3">
                <div class="se-card__head">
                    <h3><i class="bi bi-eraser me-1"></i>Demo data cleanup</h3>
                    @if (clean)
                    {
                        <span class="se-pill"><i class="bi bi-check2-circle"></i>Clean</span>
                    }
                    else
                    {
                        <span class="se-pill"><i class="bi bi-exclamation-triangle"></i>@demo!.Total row(s)</span>
                    }
                </div>
                <div class="se-card__body">
                    <p class="se-small mb-2">
                        Removes only the sample records the demo seeder created. Real data — plus the grade
                        levels, subjects, document types and system settings — is never touched. Safe to run
                        more than once.
                    </p>

                    @if (clean)
                    {
                        <p class="se-small se-muted mb-0">
                            <i class="bi bi-check2 me-1"></i>No demo records were found. The database holds real data only.
                        </p>
                    }
                    else
                    {
                        <dl class="row se-small mb-3">
                            @if (demo!.Users > 0)
                            {
                                <dt class="col-7 se-muted">Demo accounts</dt><dd class="col-5 text-end">@demo.Users</dd>
                            }
                            @if (demo.Students > 0)
                            {
                                <dt class="col-7 se-muted">Learners</dt><dd class="col-5 text-end">@demo.Students</dd>
                            }
                            @if (demo.Guardians > 0)
                            {
                                <dt class="col-7 se-muted">Guardians</dt><dd class="col-5 text-end">@demo.Guardians</dd>
                            }
                            @if (demo.Teachers + demo.Staff > 0)
                            {
                                <dt class="col-7 se-muted">Personnel</dt><dd class="col-5 text-end">@(demo.Teachers + demo.Staff)</dd>
                            }
                            @if (demo.Sections > 0)
                            {
                                <dt class="col-7 se-muted">Sections</dt><dd class="col-5 text-end">@demo.Sections</dd>
                            }
                            @if (demo.TeacherSubjectAssignments + demo.ClassSchedules > 0)
                            {
                                <dt class="col-7 se-muted">Teaching loads &amp; timetable</dt><dd class="col-5 text-end">@(demo.TeacherSubjectAssignments + demo.ClassSchedules)</dd>
                            }
                            @if (demo.AttendanceRecords + demo.GradeRecords > 0)
                            {
                                <dt class="col-7 se-muted">Attendance &amp; grade records</dt><dd class="col-5 text-end">@(demo.AttendanceRecords + demo.GradeRecords)</dd>
                            }
                            @if (demo.DocumentRequests > 0)
                            {
                                <dt class="col-7 se-muted">Document requests</dt><dd class="col-5 text-end">@demo.DocumentRequests</dd>
                            }
                            @if (demo.Enrollments > 0)
                            {
                                <dt class="col-7 se-muted">Enrolments</dt><dd class="col-5 text-end">@demo.Enrollments</dd>
                            }
                            @if (demo.Notifications + demo.Announcements > 0)
                            {
                                <dt class="col-7 se-muted">Notifications &amp; announcements</dt><dd class="col-5 text-end">@(demo.Notifications + demo.Announcements)</dd>
                            }
                            @if (demo.SchoolEvents > 0)
                            {
                                <dt class="col-7 se-muted">Calendar entries</dt><dd class="col-5 text-end">@demo.SchoolEvents</dd>
                            }
                        </dl>

                        @if (demo.SkippedSections > 0)
                        {
                            <p class="se-tiny se-muted">
                                <i class="bi bi-info-circle me-1"></i>@demo.SkippedSections section(s) are kept because
                                real learners are still enrolled in them.
                            </p>
                        }

                        <div class="mb-2">
                            <label class="se-form-label" for="purgeConfirmation">Type <code>REMOVE DEMO DATA</code> to confirm</label>
                            <input id="purgeConfirmation" name="confirmation" form="demoPurgeForm"
                                   class="form-control" placeholder="REMOVE DEMO DATA" autocomplete="off" />
                        </div>
                        <button type="submit" form="demoPurgeForm" class="btn btn-danger w-100">
                            <i class="bi bi-trash3 me-1"></i>Remove demo data
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</form>

@if (User.IsInRole(Roles.SuperAdministrator))
{
    @* Sits outside the settings form so the recovery and cleanup buttons never submit the settings. *@
    <form id="recoveryForm" method="post" class="d-none" data-se-no-loading="1">
        @Html.AntiForgeryToken()
    </form>
    <form id="demoPurgeForm" method="post" action="@Url.Action("PurgeDemoData")" class="d-none"
          data-se-no-loading="1"
          data-se-confirm="Permanently delete the demo records listed above? This cannot be undone.">
        @Html.AntiForgeryToken()
    </form>
}
