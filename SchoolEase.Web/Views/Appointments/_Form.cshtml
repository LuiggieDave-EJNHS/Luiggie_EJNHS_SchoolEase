@model AppointmentSlotFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 se-small"></div>

<div class="se-form-grid">
    <div class="se-form-section"><h3>Appointment</h3></div>

    <div class="se-span-2">
        <label class="se-form-label" asp-for="Title">Title <span class="req">*</span></label>
        <input asp-for="Title" class="form-control" placeholder="e.g. Registrar desk — document claiming" />
        <span asp-validation-for="Title" class="text-danger se-small"></span>
    </div>

    <div>
        <label class="se-form-label" asp-for="Purpose">Purpose <span class="req">*</span></label>
        <select asp-for="Purpose" asp-items="Model.Purposes" class="form-select"></select>
        <span asp-validation-for="Purpose" class="text-danger se-small"></span>
    </div>

    <div>
        <label class="se-form-label" asp-for="Capacity">Seats <span class="req">*</span></label>
        <input asp-for="Capacity" type="number" min="1" max="200" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger se-small"></span>
    </div>

    <div class="se-form-section"><h3>When &amp; where</h3></div>

    <div>
        <label class="se-form-label" asp-for="Date">Date <span class="req">*</span></label>
        <input asp-for="Date" type="date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger se-small"></span>
    </div>

    <div>
        <label class="se-form-label" asp-for="Location">Location</label>
        <input asp-for="Location" class="form-control" placeholder="Registrar's Office" />
        <span asp-validation-for="Location" class="text-danger se-small"></span>
    </div>

    <div>
        <label class="se-form-label" asp-for="StartTime">Start time <span class="req">*</span></label>
        <input asp-for="StartTime" type="time" class="form-control" />
        <span asp-validation-for="StartTime" class="text-danger se-small"></span>
    </div>

    <div>
        <label class="se-form-label" asp-for="EndTime">End time <span class="req">*</span></label>
        <input asp-for="EndTime" type="time" class="form-control" />
        <span asp-validation-for="EndTime" class="text-danger se-small"></span>
    </div>

    <div class="se-span-2">
        <label class="se-form-label" asp-for="Notes">Notes for learners</label>
        <textarea asp-for="Notes" rows="3" class="form-control"
                  placeholder="What should learners bring or prepare?"></textarea>
        <span asp-validation-for="Notes" class="text-danger se-small"></span>
    </div>

    <div class="se-span-2">
        <div class="form-check">
            <input asp-for="IsPublished" class="form-check-input" />
            <label class="form-check-label se-small" asp-for="IsPublished">Open for booking (visible to learners)</label>
        </div>
    </div>
</div>
