@{
    Layout = "_AuthLayout";
    var code = ViewData["StatusCode"] as int? ?? 404;
    var title = ViewData["Title"] as string ?? "Something went wrong";
    var (icon, message) = code switch
    {
        401 => ("bi-shield-exclamation", "You need to sign in to view this page."),
        403 => ("bi-shield-lock", "Your account does not have permission to open this page."),
        404 => ("bi-compass", "The page you are looking for could not be found or may have been moved."),
        500 => ("bi-exclamation-octagon", "Something went wrong on our side. Please try again in a moment."),
        _ => ("bi-question-circle", "We could not complete that request. Please try again.")
    };
}
<div class="se-auth__card text-center">
    <div class="se-empty__icon mx-auto" style="background:var(--se-primary-soft);color:var(--se-primary-700);">
        <i class="bi @icon"></i>
    </div>
    <h1 class="display-6 mb-1">@code</h1>
    <h2 class="h5 mb-2">@title</h2>
    <p class="se-muted se-small mb-4">@message</p>
    <div class="d-flex gap-2 justify-content-center">
        <a class="btn btn-primary" href="@(CurrentUser.IsAuthenticated ? CurrentUser.HomeAction : "/")">
            <i class="bi bi-house me-1"></i>@(CurrentUser.IsAuthenticated ? "Back to dashboard" : "Back to home")
        </a>
        <a class="btn btn-light" href="javascript:history.back()"><i class="bi bi-arrow-left me-1"></i>Go back</a>
    </div>
</div>
