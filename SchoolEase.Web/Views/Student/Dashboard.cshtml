@model StudentDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    var student = Model.Student;
    var adviser = ViewData["AdviserName"] as string;
}

@if (student is null)
{
    <partial name="_PageHeader" model="@(new PageHeader
    {
        Title = "My Dashboard",
        Subtitle = "Your learner overview.",
        Icon = "bi-speedometer2"
    })" />
    <div class="se-card">
        <partial name="_EmptyState" model="@(new EmptyState
        {
            Icon = "bi-person-badge",
            Title = "No learner record linked",
            Message = "Your account is not yet linked to a student record. Please contact the registrar to have your learner profile set up."
        })" />
    </div>
}
else
{
    <partial name="_PageHeader" model="@(new PageHeader
    {
        Title = $"Welcome, {student.FullName}",
        Subtitle = $"Your learner overview for S.Y. {SchoolInfo.SchoolYear}.",
        Icon = "bi-speedometer2"
    })" />

    <div class="se-card mb-3">
        <div class="se-card__body d-flex flex-wrap align-items-center gap-3">
            <span class="se-avatar se-avatar--lg se-avatar--@student.FullName.AvatarTone()">@student.FullName.Initials()</span>
            <div class="flex-grow-1">
                <h2 class="h5 mb-1">@student.FullName</h2>
                <div class="se-small se-muted">
                    <span class="me-3"><i class="bi bi-hash me-1"></i>@student.StudentNumber</span>
                    <span class="me-3"><i class="bi bi-diagram-3 me-1"></i>@(student.ClassLabel)</span>
                    <span class="me-3"><i class="bi bi-person-badge me-1"></i>Adviser: @(string.IsNullOrWhiteSpace(adviser) ? "Unassigned" : adviser)</span>
                </div>
            </div>
            <span class="se-badge text-bg-@student.EnrollmentStatus.BootstrapTone()">
                <i class="bi @student.EnrollmentStatus.Icon()"></i>@student.EnrollmentStatus.DisplayName()
            </span>
        </div>
    </div>

    var isFormer = User.IsInRole(Roles.FormerStudent);

    var cards = new List<StatCard>();
    if (isFormer)
    {
        cards.Add(new() { Label = "Pending Requests", Value = Model.PendingRequests.ToString("N0"), Icon = "bi-file-earmark-text", Tone = "warning", Meta = $"{Model.TotalRequests} total request(s)", Url = Url.Action("Requests") });
    }
    else
    {
        cards.Add(new() { Label = "General Average", Value = Model.GeneralAverage?.ToString("0.00") ?? "N/A", Icon = "bi-mortarboard", Tone = "primary", Meta = "Across graded subjects", Url = Url.Action("Grades") });
        cards.Add(new() { Label = "Attendance Rate", Value = $"{Model.AttendanceRate:0.#}%", Icon = "bi-graph-up", Tone = "success", Meta = "Present + late over all marks", Url = Url.Action("Attendance") });
        cards.Add(new() { Label = "Present Days", Value = Model.PresentDays.ToString("N0"), Icon = "bi-check-circle", Tone = "teal", Meta = $"{Model.LateDays} late day(s)" });
        cards.Add(new() { Label = "Absent Days", Value = Model.AbsentDays.ToString("N0"), Icon = "bi-x-circle", Tone = "danger", Meta = "Days marked absent" });
        cards.Add(new() { Label = "Pending Requests", Value = Model.PendingRequests.ToString("N0"), Icon = "bi-file-earmark-text", Tone = "warning", Meta = $"{Model.TotalRequests} total request(s)", Url = Url.Action("Requests") });
    }

    <div class="row g-3 mb-3">
        @foreach (var card in cards)
        {
            <div class="col-6 col-md-4 col-xl">
                <partial name="_StatCard" model="card" />
            </div>
        }
    </div>

    @if (!isFormer)
    {
        <div class="row g-3 mb-3">
            <div class="col-lg-7">
                <div class="se-card h-100">
                    <div class="se-card__head">
                        <h3><i class="bi bi-clock-history me-1"></i>Today's classes</h3>
                        <a class="se-small" asp-action="Schedule">Full week</a>
                    </div>
                    <div class="se-card__body">
                        @if (Model.TodaySchedule.Count == 0)
                        {
                            <p class="se-muted se-small mb-0">No classes are scheduled for today.</p>
                        }
                        else
                        {
                            <ul class="se-timeline">
                                @foreach (var slot in Model.TodaySchedule)
                                {
                                    <li>
                                        <span class="se-strong se-small d-block">@slot.TimeRange</span>
                                        <span class="d-block">
                                            <span class="se-strong">@slot.Subject?.Code</span>
                                            <span class="se-muted">@slot.Subject?.Title</span>
                                        </span>
                                        <span class="se-small se-muted d-block">
                                            <i class="bi bi-person-video3 me-1"></i>@(slot.Teacher?.FullName ?? "Unassigned")
                                            @if (!string.IsNullOrWhiteSpace(slot.Room))
                                            {
                                                <span> • <i class="bi bi-geo-alt me-1"></i>@slot.Room</span>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <partial name="_ChartCard" model="@(new ChartWidget { Data = Model.AttendanceTrend, Type = "line", Height = "se-chart--sm", DatasetLabel = "Present + late" })" />
            </div>
        </div>
    }

    <div class="row g-3 mb-3">
        @if (!isFormer)
        {
            <div class="col-lg-7">
                <div class="se-card h-100 mb-0">
                    <div class="se-card__head">
                        <h3><i class="bi bi-mortarboard me-1"></i>Latest grades</h3>
                        <a class="se-small" asp-action="Grades">All grades</a>
                    </div>
                    @if (Model.LatestGrades.Count == 0)
                    {
                        <partial name="_EmptyState" model="@(new EmptyState
                        {
                            Icon = "bi-mortarboard",
                            Title = "No grades yet",
                            Message = "Your grades will appear here once your teachers encode them."
                        })" />
                    }
                    else
                    {
                        <div class="se-table-wrap">
                            <table class="se-table se-table--compact">
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th class="text-center">Term</th>
                                        <th class="text-end">Final Grade</th>
                                        <th>Remarks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var grade in Model.LatestGrades)
                                    {
                                        <tr>
                                            <td><span class="se-strong">@grade.Subject?.Code</span> <span class="se-muted se-small">@grade.Subject?.Title</span></td>
                                            <td class="text-center">T@(grade.Term)</td>
                                            <td class="text-end">@(grade.FinalGrade?.ToString("0.00") ?? "-")</td>
                                            <td>@grade.FinalGrade.GradeRemarks()</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="@(isFormer ? "col-12" : "col-lg-5")">
            <div class="se-card h-100 mb-0">
                <div class="se-card__head">
                    <h3><i class="bi bi-file-earmark-text me-1"></i>Recent requests</h3>
                    <a class="se-small" asp-action="Requests">View all</a>
                </div>
                @if (Model.RecentRequests.Count == 0)
                {
                    <partial name="_EmptyState" model="@(new EmptyState
                    {
                        Icon = "bi-inboxes",
                        Title = "No requests yet",
                        Message = "Request a school document and track its status here.",
                        ActionText = "Request a document",
                        ActionUrl = Url.Action("Requests")
                    })" />
                }
                else
                {
                    <div class="se-table-wrap">
                        <table class="se-table se-table--compact">
                            <thead>
                                <tr>
                                    <th>Document</th>
                                    <th>Requested</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.RecentRequests)
                                {
                                    <tr>
                                        <td>@request.DocumentType?.Name</td>
                                        <td class="se-small">@request.RequestedAt.ToLocalTime().ToDateLabel()</td>
                                        <td>
                                            <span class="se-badge text-bg-@request.Status.BootstrapTone()">
                                                <i class="bi @request.Status.Icon()"></i>@request.Status.DisplayName()
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="se-card h-100 mb-0">
                <div class="se-card__head">
                    <h3><i class="bi bi-megaphone me-1"></i>Announcements</h3>
                    <a class="se-small" asp-controller="Announcements" asp-action="Index">View all</a>
                </div>
                <div class="se-card__body">
                    @if (Model.Announcements.Count == 0)
                    {
                        <p class="se-muted se-small mb-0">No announcements have been posted yet.</p>
                    }
                    else
                    {
                        foreach (var item in Model.Announcements)
                        {
                            <div class="se-announce se-announce--@item.PriorityCss">
                                <h4>@item.Title</h4>
                                <p>@(item.Content.Length > 190 ? item.Content[..190] + "…" : item.Content)</p>
                                <div class="se-announce__meta">
                                    <span><i class="bi bi-person me-1"></i>@item.AuthorName</span>
                                    <span><i class="bi bi-clock me-1"></i>@item.PublishDate.ToRelativeTime()</span>
                                    <span class="se-badge text-bg-@item.PriorityCss">@item.Priority.DisplayName()</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="se-card h-100 mb-0">
                <div class="se-card__head">
                    <h3><i class="bi bi-calendar3 me-1"></i>Upcoming events</h3>
                    <a class="se-small" asp-controller="Calendar" asp-action="Index">Calendar</a>
                </div>
                <div class="se-card__body">
                    @if (Model.UpcomingEvents.Count == 0)
                    {
                        <p class="se-muted se-small mb-0">Nothing scheduled coming up.</p>
                    }
                    else
                    {
                        foreach (var evt in Model.UpcomingEvents)
                        {
                            <div class="se-event-row">
                                <span class="se-event-date" style="background:@(evt.ColorHex)1a;color:@evt.ColorHex;">
                                    <strong>@evt.StartDate.Day</strong>
                                    <span>@evt.StartDate.ToString("MMM")</span>
                                </span>
                                <span>
                                    <span class="se-strong se-small d-block">@evt.Title</span>
                                    <span class="se-small se-muted">@evt.Category.DisplayName()@(string.IsNullOrWhiteSpace(evt.Location) ? "" : $" • {evt.Location}")</span>
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}
