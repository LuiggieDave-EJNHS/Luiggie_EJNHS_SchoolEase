@model Student
@{
    ViewData["Title"] = "My Profile";
}

<partial name="_PageHeader" model="@(new PageHeader
{
    Title = "My Profile",
    Subtitle = "Your learner record on file with the registrar.",
    Icon = "bi-person-badge"
})" />

@if (Model is null)
{
    <div class="se-card">
        <partial name="_EmptyState" model="@(new EmptyState
        {
            Icon = "bi-person-badge",
            Title = "No learner record linked",
            Message = "Your account is not yet linked to a student record. Please contact the registrar."
        })" />
    </div>
}
else
{
    <div class="se-card mb-3">
        <div class="se-card__body d-flex flex-wrap align-items-center gap-3">
            <span class="se-avatar se-avatar--lg se-avatar--@Model.FullName.AvatarTone()">@Model.FullName.Initials()</span>
            <div class="flex-grow-1">
                <h2 class="h5 mb-1">@Model.FullName</h2>
                <div class="se-small se-muted">
                    <span class="me-3"><i class="bi bi-hash me-1"></i>@Model.StudentNumber</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Lrn))
                    {
                        <span class="me-3"><i class="bi bi-card-text me-1"></i>LRN @Model.Lrn</span>
                    }
                    <span class="me-3"><i class="bi bi-diagram-3 me-1"></i>@Model.ClassLabel</span>
                </div>
            </div>
            <span class="se-badge text-bg-@Model.EnrollmentStatus.BootstrapTone()">
                <i class="bi @Model.EnrollmentStatus.Icon()"></i>@Model.EnrollmentStatus.DisplayName()
            </span>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="se-card h-100 mb-0">
                <div class="se-card__head"><h3><i class="bi bi-person me-1"></i>Personal information</h3></div>
                <div class="se-card__body">
                    <dl class="se-def-list mb-0">
                        <dt>Full Name</dt>
                        <dd>@Model.FullName</dd>

                        <dt>Student Number</dt>
                        <dd>@Model.StudentNumber</dd>

                        <dt>Sex</dt>
                        <dd>@Model.Gender.DisplayName()</dd>

                        <dt>Date of Birth</dt>
                        <dd>@(Model.BirthDate?.ToDateLabel() ?? "-")</dd>

                        <dt>Address</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</dd>

                        <dt>Contact Number</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.ContactNumber) ? "-" : Model.ContactNumber)</dd>

                        <dt>Email</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="se-card h-100 mb-0">
                <div class="se-card__head"><h3><i class="bi bi-journal-text me-1"></i>Academic &amp; enrollment</h3></div>
                <div class="se-card__body">
                    <dl class="se-def-list mb-0">
                        <dt>Grade Level</dt>
                        <dd>@(Model.GradeLevel?.Name ?? "Unassigned")</dd>

                        <dt>Section</dt>
                        <dd>@(Model.Section?.Name ?? "No Section")</dd>

                        <dt>Class Adviser</dt>
                        <dd>@(Model.Section?.Adviser?.FullName ?? "Unassigned")</dd>

                        <dt>Track / Strand</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Section?.TrackStrand) ? "-" : Model.Section!.TrackStrand)</dd>

                        <dt>Enrollment Status</dt>
                        <dd>
                            <span class="se-badge text-bg-@Model.EnrollmentStatus.BootstrapTone()">
                                <i class="bi @Model.EnrollmentStatus.Icon()"></i>@Model.EnrollmentStatus.DisplayName()
                            </span>
                        </dd>

                        <dt>Date Enrolled</dt>
                        <dd>@Model.DateEnrolled.ToDateLabel()</dd>

                        <dt>Record Status</dt>
                        <dd>
                            <span class="se-badge text-bg-@(Model.IsActive ? "success" : "secondary")">
                                <i class="bi @(Model.IsActive ? "bi-check-circle" : "bi-slash-circle")"></i>@(Model.IsActive ? "Active" : "Inactive")
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="se-card h-100 mb-0">
                <div class="se-card__head"><h3><i class="bi bi-person-hearts me-1"></i>Guardian information</h3></div>
                <div class="se-card__body">
                    @if (Model.Guardian is null)
                    {
                        <p class="se-muted se-small mb-0">No guardian is on record for this learner.</p>
                    }
                    else
                    {
                        <dl class="se-def-list mb-0">
                            <dt>Guardian Name</dt>
                            <dd>@Model.Guardian.FullName</dd>

                            <dt>Relationship</dt>
                            <dd>@Model.Guardian.Relationship</dd>

                            <dt>Contact Number</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.Guardian.ContactNumber) ? "-" : Model.Guardian.ContactNumber)</dd>

                            <dt>Email</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.Guardian.Email) ? "-" : Model.Guardian.Email)</dd>

                            <dt>Address</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.Guardian.Address) ? "-" : Model.Guardian.Address)</dd>

                            <dt>Occupation</dt>
                            <dd>@(string.IsNullOrWhiteSpace(Model.Guardian.Occupation) ? "-" : Model.Guardian.Occupation)</dd>
                        </dl>
                    }
                </div>
            </div>
        </div>
    </div>
}
