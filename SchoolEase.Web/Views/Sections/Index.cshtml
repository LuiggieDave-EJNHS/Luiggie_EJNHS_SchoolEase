@model PagedList<Section>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Classes & Sections";
    var gradeLevelOptions = ViewData["GradeLevelOptions"] as List<SelectListItem> ?? new List<SelectListItem>();
    var keyword = ViewData["Keyword"] as string;
    var gradeLevelId = ViewData["GradeLevelId"] as int?;
}

<partial name="_PageHeader" model="@(new PageHeader
{
    Title = "Classes & Sections",
    Subtitle = $"{Model.TotalCount} section{(Model.TotalCount == 1 ? "" : "s")} for S.Y. {SchoolInfo.SchoolYear}",
    Icon = "bi-diagram-3",
    Actions = new List<PageAction>
    {
        new() { Text = "New Section", Url = Url.Action("Create"), Icon = "bi-plus-lg" }
    }
})" />

<div class="se-card">
    <form asp-action="Index" method="get" class="se-filters">
        <div class="se-filters__grow">
            <label class="form-label">Search</label>
            <input type="search" name="keyword" value="@keyword" class="form-control" placeholder="Section name, code or strand" />
        </div>
        <div>
            <label class="form-label">Grade level</label>
            <select name="gradeLevelId" class="form-select" data-se-autosubmit>
                <option value="">All grade levels</option>
                @foreach (var option in gradeLevelOptions)
                {
                    <option value="@option.Value" selected="@(gradeLevelId.HasValue && gradeLevelId.Value.ToString() == option.Value)">@option.Text</option>
                }
            </select>
        </div>
        <div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Search</button>
        </div>
        <div>
            <button type="button" class="btn btn-light" data-se-reset="@Url.Action("Index")">Reset</button>
        </div>
    </form>

    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyState
        {
            Icon = "bi-diagram-3",
            Title = "No sections found",
            Message = "Adjust the filters or create a new section to organise your learners into classes.",
            ActionText = "New section",
            ActionUrl = Url.Action("Create")
        })" />
    }
    else
    {
        <div class="se-table-wrap">
            <table class="se-table">
                <thead>
                    <tr>
                        <th>Section</th>
                        <th>Code</th>
                        <th>Grade Level</th>
                        <th>Adviser</th>
                        <th>Track / Strand</th>
                        <th>Room</th>
                        <th class="text-center">Capacity</th>
                        <th class="text-center">Enrolled</th>
                        <th class="se-col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sec in Model)
                    {
                        <tr>
                            <td>
                                <a class="se-strong text-decoration-none" asp-action="Details" asp-route-id="@sec.Id">@sec.DisplayName</a>
                                @if (!sec.IsActive)
                                {
                                    <span class="se-badge text-bg-secondary ms-1">Inactive</span>
                                }
                            </td>
                            <td><span class="se-id-chip">@sec.Code</span></td>
                            <td>@sec.GradeLevel?.Name</td>
                            <td>
                                @if (sec.Adviser is not null)
                                {
                                    <span class="d-inline-flex align-items-center gap-2">
                                        <span class="se-avatar se-avatar--@sec.Adviser.FullName.AvatarTone()">@sec.Adviser.FullName.Initials()</span>
                                        <span>@sec.Adviser.FullName</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="se-muted se-small">Unassigned</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(sec.TrackStrand) ? "—" : sec.TrackStrand)</td>
                            <td>@(string.IsNullOrWhiteSpace(sec.Room) ? "—" : sec.Room)</td>
                            <td class="text-center">@sec.Capacity</td>
                            <td class="text-center">
                                <span class="se-badge text-bg-@(sec.StudentCount >= sec.Capacity ? "danger" : "primary")">@sec.StudentCount</span>
                            </td>
                            <td class="se-col-actions">
                                <a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@sec.Id" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@sec.Id" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@sec.Id" method="post" class="d-inline"
                                      data-se-confirm="Delete this section?">
                                    <button type="submit" class="btn btn-sm btn-light text-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="@(ViewData["Pagination"] as PaginationInfo ?? new PaginationInfo())" />
    }
</div>
