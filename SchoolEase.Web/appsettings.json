{
  "Database": {
    "Provider": "Sqlite",
    "MySqlVersion": "8.0.36",
    "EnableSensitiveDataLogging": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=schoolease.db"
  },
  "Seed": {
    "Enabled": true,
    "DemoData": false
  },
  "Https": {
    "Redirect": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
